<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Flight.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: logo + title; the system draws the close button. -->
        <StackPanel x:Name="TitleBar" Orientation="Horizontal" Spacing="10" Padding="16,0" VerticalAlignment="Center">
            <Image x:Name="TitleLogo" Width="16" Height="16" />
            <TextBlock Text="Settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16,4,16,16" Spacing="8">

                <TextBlock Text="Language" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,4,0,0" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="I speak" />
                            <TextBlock Text="Never auto-detected" Style="{StaticResource CaptionMutedTextStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="SourceLanguageBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                  DisplayMemberPath="EnglishName" SelectionChanged="OnLanguageChanged"
                                  AutomationProperties.Name="Language I speak" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Give me text in" />
                            <TextBlock Text="A different language translates" Style="{StaticResource CaptionMutedTextStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="TargetLanguageBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                  DisplayMemberPath="EnglishName" SelectionChanged="OnLanguageChanged"
                                  AutomationProperties.Name="Language for the text" />
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource CaptionMutedTextStyle}" Margin="4,0" />

                <TextBlock Text="Cleanup engine" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,12,0,0" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Use the cloud model" />
                            <TextBlock Text="Local is free, private and works offline" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionMutedTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="CloudModeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      VerticalAlignment="Center" Toggled="OnCloudModeToggled"
                                      AutomationProperties.Name="Use the cloud model" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cloud API key" />
                        <PasswordBox x:Name="ApiKeyBox" PlaceholderText="Stored encrypted on this device"
                                     PasswordChanged="OnApiKeyChanged" AutomationProperties.Name="Cloud API key" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="EngineStatusText" TextWrapping="Wrap" Style="{StaticResource CaptionMutedTextStyle}" Margin="4,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
