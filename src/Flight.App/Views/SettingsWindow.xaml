<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Flight.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Language" Style="{ThemeResource SubtitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="I speak" />
            <ComboBox x:Name="SourceLanguageBox"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="EnglishName"
                      SelectionChanged="OnLanguageChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="Give me text in" />
            <ComboBox x:Name="TargetLanguageBox"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="EnglishName"
                      SelectionChanged="OnLanguageChanged" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}" />

        <TextBlock Grid.Row="4" Text="Cleanup engine" Style="{ThemeResource SubtitleTextBlockStyle}" />

        <StackPanel Grid.Row="5" Spacing="6">
            <ToggleSwitch x:Name="CloudModeToggle"
                          Header="Use cloud model"
                          OffContent="Local (free, private, offline)"
                          OnContent="Cloud (needs an API key)"
                          Toggled="OnCloudModeToggled" />
            <PasswordBox x:Name="ApiKeyBox"
                         Header="Cloud API key"
                         PlaceholderText="Stored encrypted on this device"
                         PasswordChanged="OnApiKeyChanged" />
            <TextBlock x:Name="EngineStatusText"
                       TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>

        <Button Grid.Row="6" Content="Close" Click="OnCloseClicked" HorizontalAlignment="Right" />
    </Grid>
</Window>
