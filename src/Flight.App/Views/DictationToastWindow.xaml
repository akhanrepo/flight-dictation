<Window
    x:Class="Flight.App.Views.DictationToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Flight">
    <Grid Padding="20,16" KeyDown="OnKeyDown" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="StatusText" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Flight" />
                <ProgressRing x:Name="Spinner" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="SettingsButton" HorizontalAlignment="Right" Padding="6,2"
                    Click="OnSettingsClicked" Content="Settings" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,10" MaxHeight="200">
            <StackPanel Spacing="8">
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Visibility="Collapsed" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <ProgressBar x:Name="DownloadBar" Visibility="Collapsed" Minimum="0" Maximum="100" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="PreviewButtons" Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Visibility="Collapsed">
            <Button x:Name="ConfirmButton" Style="{ThemeResource AccentButtonStyle}" Click="OnConfirmClicked"
                    Content="Copy (Enter)" />
            <Button x:Name="DismissButton" Click="OnDismissClicked" Content="Dismiss (Esc)" />
        </StackPanel>
    </Grid>
</Window>
