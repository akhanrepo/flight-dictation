<Window
    x:Class="Flight.App.Views.DictationToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Flight">

    <!-- Renders a Core ToastView (feature #7). The whole surface drags the
         window; buttons and the text are click-through regions. -->
    <Grid x:Name="Root" KeyDown="OnKeyDown" Background="Transparent">
        <Grid.Resources>
            <Storyboard x:Name="ListeningPulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="ListeningDot" Storyboard.TargetProperty="Opacity"
                                 From="1" To="0.35" Duration="0:0:0.7" />
            </Storyboard>
            <Storyboard x:Name="FadeOut">
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.2" />
            </Storyboard>
        </Grid.Resources>

        <StackPanel x:Name="ContentPanel" Padding="16,12" Spacing="8" VerticalAlignment="Top">

            <!-- Header: indicator · title (and pill hint) · icon buttons -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse x:Name="ListeningDot" Width="10" Height="10" Fill="#EF4444" Visibility="Collapsed" />
                    <ProgressRing x:Name="Spinner" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <Image x:Name="Logo" Width="16" Height="16" Visibility="Collapsed" />
                    <FontIcon x:Name="ToneIcon" FontSize="14" Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock x:Name="PillHintText" Style="{StaticResource CaptionMutedTextStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="HeaderButtons" Grid.Column="2" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"
                            Click="OnSettingsClicked">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Dismiss (Esc)" AutomationProperties.Name="Dismiss"
                            Click="OnDismissClicked">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="100" Visibility="Collapsed" />

            <ScrollViewer x:Name="BodyScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           LineHeight="20" Margin="0,0,4,0" />
            </ScrollViewer>

            <!-- Footer: shortcut hint left, compact actions right -->
            <Grid x:Name="Footer" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText" Style="{StaticResource CaptionMutedTextStyle}" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PrimaryButton" Style="{StaticResource CompactAccentButtonStyle}"
                            Click="OnPrimaryClicked" Visibility="Collapsed" />
                    <Button x:Name="SecondaryButton" Style="{StaticResource CompactButtonStyle}"
                            Click="OnSecondaryClicked" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
