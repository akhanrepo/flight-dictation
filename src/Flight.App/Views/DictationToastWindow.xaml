<Window
    x:Class="Flight.App.Views.DictationToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Flight">

    <!-- The indicator pill (feature #9). Renders a Core ToastView; the whole
         surface drags the window, and it never takes keyboard focus. -->
    <Grid x:Name="Root" Background="Transparent" Padding="14,0">
        <Grid.Resources>
            <Storyboard x:Name="ListeningPulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="ListeningDot" Storyboard.TargetProperty="Opacity"
                                 From="1" To="0.35" Duration="0:0:0.7" />
            </Storyboard>
            <Storyboard x:Name="FadeOut">
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.2" />
            </Storyboard>
        </Grid.Resources>

        <StackPanel x:Name="ContentPanel" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Indicator: one of dot / spinner / tone icon / logo -->
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse x:Name="ListeningDot" Width="10" Height="10" Fill="#EF4444" Visibility="Collapsed" />
                <ProgressRing x:Name="Spinner" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                <FontIcon x:Name="ToneIcon" FontSize="14" Visibility="Collapsed" />
                <Image x:Name="Logo" Width="16" Height="16" Visibility="Collapsed" />
            </Grid>

            <!-- Live microphone level while listening -->
            <StackPanel x:Name="LevelBars" Orientation="Horizontal" Spacing="3" Height="20"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <Rectangle x:Name="Bar0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                <Rectangle x:Name="Bar4" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="TitleText" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="Collapsed" />

            <ProgressBar x:Name="DownloadBar" Width="64" Minimum="0" Maximum="100" VerticalAlignment="Center"
                         Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
