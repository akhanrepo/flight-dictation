<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Flight.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Solution-level builds pass AnyCPU; WinAppSDK self-contained needs a concrete arch -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by assets/brand/make_logo.py -->
    <ApplicationIcon>..\..\assets\brand\flight.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.Main runs Velopack's install/update hooks before WinUI starts -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- WinMM only (WaveInEvent): the NAudio meta-package drags in WinForms/WPF -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- DPAPI for the cloud API key: encrypted at rest under the current user -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bound onto FlightOptions by AppHost (the "Flight" section) -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Window, tray-state and notification icons, loaded from Assets\ at runtime (AppIcons) -->
    <Content Include="..\..\assets\brand\*.ico" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flight.Core\Flight.Core.csproj" />
  </ItemGroup>

  <!-- Whisper.net and LLamaSharp ship native libraries for every OS; an
       installer only needs the one it was published for. -->
  <Target Name="TrimForeignNativeRuntimes" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_PublishedRuntimeDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes'))"
                             Condition="Exists('$(PublishDir)runtimes')" />
      <_ForeignRuntimeDirs Include="@(_PublishedRuntimeDirs)" Condition="'%(Filename)%(Extension)' != '$(RuntimeIdentifier)'" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignRuntimeDirs)" />
  </Target>

</Project>
